# Copy to .env and fill in. Never commit the real one.

# "dev" lets the app start without a SECRET_KEY (it makes a throwaway one).
# Anything else, including leaving this out, is treated as production.
AUTHGUARD_ENV=dev

# At least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# It protects CSRF tokens, encrypted authenticator secrets and backup-code hashes.
# Changing it later signs nobody out, but it makes existing authenticator secrets unreadable.
SECRET_KEY=

# SQLite for quick local runs, Postgres for real use.
DATABASE_URL=sqlite:///./authguard.db
# DATABASE_URL=postgresql+psycopg://authguard:password@localhost:5432/authguard

# Used by docker-compose for the Postgres container.
POSTGRES_PASSWORD=change-me-locally

# Secure cookies are sent over HTTPS only. Browsers make an exception for
# http://localhost, so true usually still works there.
COOKIE_SECURE=false

# Only true when exactly one reverse proxy (nginx, Caddy) sits in front.
TRUST_PROXY_HEADERS=false

# Optional tuning, these are the defaults:
# SESSION_IDLE_MINUTES=30
# SESSION_ABSOLUTE_HOURS=12
# MAX_FAILED_ATTEMPTS=5
# LOCKOUT_MINUTES=15
# MIN_PASSWORD_LENGTH=12
# PASSWORD_HISTORY=5
